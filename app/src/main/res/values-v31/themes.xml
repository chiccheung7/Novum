<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        API 31+ 系统 Splash：背景与 App 底色一致，避免冷启动时先闪一帧系统亮色。
        Android 12 起启动窗口由系统 SplashScreen 接管，只设 windowBackground 不再够用。
    -->
    <style name="Theme.Novum" parent="Theme.Novum.Base">
        <item name="android:windowSplashScreenBackground">@color/novum_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/novum_ink</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
